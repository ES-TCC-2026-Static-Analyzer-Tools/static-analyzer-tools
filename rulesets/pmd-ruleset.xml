<?xml version="1.0"?>
<ruleset name="SonarEquivalentRuleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Sonar Equivalent Ruleset</description>

    <!-- 1. Reliability & Bugs -->
    <rule ref="category/java/errorprone.xml"/>
    <rule ref="category/java/multithreading.xml"/>

    <!-- 2. Security -->
    <rule ref="category/java/security.xml"/>

    <!-- 3. Maintainability & Design -->
    <rule ref="category/java/design.xml">
        <exclude name="LoosePackageCoupling"/>
    </rule>

    <!-- Calibrando o limite de Complexidade Ciclomatica para bater com o Sonar (Limite = 10) -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="classReportLevel" value="1"/>
            <property name="methodReportLevel" value="1"/>
        </properties>
    </rule>

    <!-- 4. Code Smells & Best Practices -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="GuardLogStatement"/> <!-- Excesso de verbosidade em logs -->
    </rule>
    
    <rule ref="category/java/codestyle.xml">
        <exclude name="AtLeastOneConstructor"/> <!-- Sonar nao exige construtor explicito -->
        <exclude name="OnlyOneReturn"/> <!-- Sonar permite múltiplos returns quando claros -->
    </rule>
</ruleset>